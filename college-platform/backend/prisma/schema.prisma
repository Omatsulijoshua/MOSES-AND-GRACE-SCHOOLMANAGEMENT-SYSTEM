generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  fullname     String   @db.VarChar(255)
  email        String   @unique @db.VarChar(255)
  passwordHash String
  matricNo     String?  @db.VarChar(50)
  department   String?  @db.VarChar(255)
  level        String?  @db.VarChar(50)
  role         String   @default("STUDENT") @db.VarChar(20) // STUDENT, ADMIN, STAFF, DRIVER
  status       String   @default("ACTIVE") @db.VarChar(20) // ACTIVE, SUSPENDED
  createdAt    DateTime @default(now())

  transactions Transaction[]
  wallet       Wallet?
  studentPayments StudentPayment[]
}

model Program {
  id          Int    @id @default(autoincrement())
  title       String @db.VarChar(255)
  description String
  duration    String @db.VarChar(100)
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(255)
  content   String
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  fullname  String   @db.VarChar(255)
  email     String   @db.VarChar(255)
  message   String
  createdAt DateTime @default(now())
}

model Transaction {
  id            Int      @id @default(autoincrement())
  reference     String   @unique @db.VarChar(100)
  userId        Int
  amount        Float
  status        String   @default("PENDING") @db.VarChar(20) // SUCCESS, PENDING, FAILED
  paymentMethod String   @default("OPAY") @db.VarChar(50) // OPAY, TRANSFER, CARD
  gatewayFee    Float    @default(0.0)
  netAmount     Float    @default(0.0)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Wallet {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  balance   Float    @default(0.0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id          Int      @id @default(autoincrement())
  walletId    Int
  type        String   @db.VarChar(20) // CREDIT, DEBIT
  amount      Float
  description String?
  createdAt   DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
}

model Payout {
  id            Int      @id @default(autoincrement())
  recipientName String   @db.VarChar(255)
  amount        Float
  bankName      String   @db.VarChar(100)
  accountNumber String   @db.VarChar(50)
  status        String   @default("PENDING") @db.VarChar(20) // SUCCESS, PENDING, FAILED
  createdAt     DateTime @default(now())
}

model AdminLog {
  id          Int      @id @default(autoincrement())
  adminId     Int
  action      String   @db.VarChar(255)
  description String?
  createdAt   DateTime @default(now())
}

model PaymentCategory {
  id              Int              @id @default(autoincrement())
  title           String           @db.VarChar(255)
  description     String?
  amount          Float
  paymentType     String           @db.VarChar(50) // School Fees, Acceptance Fee, etc.
  academicSession String?          @db.VarChar(50) // e.g., 2026/2027
  semester        String?          @db.VarChar(50) // e.g., 1st, 2nd
  department      String?          @db.VarChar(255) // e.g., Nursing, All
  level           String?          @db.VarChar(50)  // e.g., ND1, Final Year
  isCompulsory    Boolean          @default(true)
  dueDate         DateTime?
  status          String           @default("ACTIVE") @db.VarChar(20) // ACTIVE, INACTIVE, ARCHIVED
  createdAt       DateTime         @default(now())
  
  studentPayments StudentPayment[]
}

model StudentPayment {
  id                Int             @id @default(autoincrement())
  studentId         Int
  paymentCategoryId Int
  feeAmount         Float           // The amount of the fee at the time of payment/assignment
  amountPaid        Float           @default(0.0)
  balanceRemaining  Float
  status            String          @default("UNPAID") @db.VarChar(20) // UNPAID, PENDING, PARTIALLY_PAID, PAID, OVERDUE
  reference         String?         @db.VarChar(100)
  paidAt            DateTime?
  createdAt         DateTime        @default(now())

  student         User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  paymentCategory PaymentCategory @relation(fields: [paymentCategoryId], references: [id], onDelete: Cascade)
}
